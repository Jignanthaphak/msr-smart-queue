@echo off
chcp 65001 >nul
title ติดตั้งไดรเวอร์การ์ดจอ Intel GMA 3150 (64-bit)
echo ========================================================
echo   กำลังติดตั้งไดรเวอร์การ์ดจอ Intel GMA 3150 (64-bit)...
echo   ระบบจะปลดล็อกความละเอียดหน้าจอ และเปิดฮาร์ดแวร์กราฟิก
echo ========================================================
echo.

cd /d "%~dp0"

echo [1/2] กำลังติดตั้งไดรเวอร์ผ่าน pnputil...
pnputil /add-driver "%~dp0igdlh.inf" /install
if %errorlevel% neq 0 (
    echo ลองติดตั้งด้วยคำสั่ง pnputil สำรอง...
    pnputil -i -a "%~dp0igdlh.inf"
)

echo.
echo ========================================================
echo   ติดตั้งเรียบร้อยแล้วค่ะ!
echo   หากหน้าจอยังไม่เปลี่ยนเป็น 1024x768 อัตโนมัติ:
echo   - ให้รีสตาร์ตเครื่อง (Restart) 1 ครั้ง
echo   - หรือไปปรับที่ Display Settings เลือก 1024x768 นะคะ
echo ========================================================
echo.
pause
